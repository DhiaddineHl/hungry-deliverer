{
  "expo": {
    "name": "hungry-deliverer",
    "slug": "hungry-deliverer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hungrydeliverer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.hungry.deliverer"
    },
    "android": {
      "package": "com.hungry.deliverer",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "aa0dde7b-274d-4d31-9025-95ecce384900"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#003049",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hungry Deliverer uses your location to find orders near you and guide you to pickups and drop-offs.",
          "locationAlwaysAndWhenInUsePermission": "Hungry Deliverer uses your location to find orders near you and guide you to pickups and drop-offs."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hungry Deliverer uses your photos to attach the documents of your deliverer application.",
          "cameraPermission": "Hungry Deliverer uses your camera to take your live photo and pictures of your documents for your deliverer application.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#EA8608",
          "defaultChannel": "orders"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/poppins/400Regular/Poppins_400Regular.ttf",
            "./node_modules/@expo-google-fonts/poppins/500Medium/Poppins_500Medium.ttf",
            "./node_modules/@expo-google-fonts/poppins/600SemiBold/Poppins_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/poppins/700Bold/Poppins_700Bold.ttf",
            "./node_modules/@expo-google-fonts/poppins/800ExtraBold/Poppins_800ExtraBold.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "dhiaddinehlaoui"
  }
}
