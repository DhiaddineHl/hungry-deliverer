# Google Maps SDK key, injected into the react-native-maps config plugin by app.config.ts.
# Needed for native builds (npx expo run:android / run:ios). Expo Go on Android works without it.
# Enable "Maps SDK for Android" and "Maps SDK for iOS" on the key in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Same key, exposed to JS at build time for in-app turn-by-turn (Routes API HTTP calls).
# Metro inlines EXPO_PUBLIC_* vars into the bundle. Enable "Routes API" on the key too.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Keycloak / backend -------------------------------------------------
# Every EXPO_PUBLIC_* value is inlined into the bundle in plaintext: only
# public client data belongs here. Never put a Keycloak admin or service
# account secret in this file — account creation goes through the backend.
#
# On a physical device `localhost` is the phone: use the dev machine's LAN IP
# for both URLs (and allow cleartext on Android, or serve over HTTPS).
EXPO_PUBLIC_KEYCLOAK_URL=http://172.29.80.1:8081
EXPO_PUBLIC_KEYCLOAK_REALM=hungry
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=hungry-deliverer-app

# Hungry backend (Spring Boot) — must be reachable from the device too.
EXPO_PUBLIC_API_URL=http://172.29.80.1:8080
