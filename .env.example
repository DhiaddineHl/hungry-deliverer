# Google Maps SDK key, injected into the react-native-maps config plugin by app.config.ts.
# Needed for native builds (npx expo run:android / run:ios). Expo Go on Android works without it.
# Enable "Maps SDK for Android" and "Maps SDK for iOS" on the key in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Same key, exposed to JS at build time for in-app turn-by-turn (Routes API HTTP calls).
# Metro inlines EXPO_PUBLIC_* vars into the bundle. Enable "Routes API" on the key too.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Keycloak / backend -------------------------------------------------
# Every EXPO_PUBLIC_* value is inlined into the bundle in plaintext: only
# public client data belongs here. Never put a Keycloak admin or service
# account secret in this file — account creation goes through the backend.
#
# KEYCLOAK URL: keep this on the same host Keycloak advertises as its public URL
# (backend compose pins KC_HOSTNAME=http://localhost:8081). Keycloak builds every
# browser-facing redirect from KC_HOSTNAME, so a mismatch here bounces the browser
# to that host mid-flow and breaks Google sign-in ("localhost refused to connect"
# on a device that cannot reach it). The back-channel calls — login, refresh,
# userinfo, logout — work over any host that reaches Keycloak, which is why the
# password login keeps working while the Google button does not.
# If you change this, change KC_HOSTNAME and KEYCLOAK_ISSUER_URI (hungry-app AND
# gateway) with it, or every token is rejected on its `iss` claim.
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8081
EXPO_PUBLIC_KEYCLOAK_REALM=hungry
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=hungry-deliverer-app

# Hungry backend — the jfwk-gateway edge (:8082), NOT hungry-app (:8080). Unlike
# the Keycloak URL above this one is only ever called from the app, so it must be
# reachable from the device: use the dev machine's LAN IP on a physical device.
EXPO_PUBLIC_API_URL=http://<dev-machine-lan-ip>:8082
